#NEXT
NEXT_PUBLIC_SITE_URL=http://localhost:3000

#APPWRITE
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=
APPWRITE_DATABASE_ID=
APPWRITE_USER_COLLECTION_ID=
APPWRITE_ITEM_COLLECTION_ID=
APPWRITE_BANK_COLLECTION_ID=
APPWRITE_TRANSACTION_COLLECTION_ID=
APPWRITE_STATEMENT_COLLECTION_ID=
NEXT_APPWRITE_KEY=

#PLAID
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
PLAID_PRODUCTS=
PLAID_COUNTRY_CODES=

#SETU (Account Aggregator, India) - from The Bridge dashboard
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_BASE_URL=https://fiu-sandbox.setu.co

#DWOLLA
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_BASE_URL=
DWOLLA_ENV=
#ENCRYPTION
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Losing or changing it makes stored bank tokens unreadable.
DATA_ENCRYPTION_KEY=

#PROXY
# How many proxies sit in front of the app (Vercel, Render, Railway or one nginx = 1).
TRUSTED_PROXY_HOPS=1

#REDIS (Upstash) - shared rate limits and the transfer double-send guard across server instances.
# From the Upstash console: your database -> REST API. Leave empty to keep everything in memory
# (fine for one server; needed once there are several).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Lets one Upstash database serve both development and production without mixing their keys.
REDIS_PREFIX=horizon
# For development use a prefix ending in -dev (e.g. horizon-dev); "npm run reset-dev-limits" then clears its limits.

#SUPABASE (login). Server-only: never give these a NEXT_PUBLIC_ name.
# Settings -> API in the Supabase dashboard. In Authentication, turn public sign-up off:
# only Horizon's server creates accounts, after its own checks.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

#RAZORPAY (test mode while building). Dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Plan ids: node scripts/setup-razorpay-plans.mjs --apply prints them (prices come from src/lib/plans.ts).
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# Dashboard -> Webhooks -> Add: URL https://<your site>/api/razorpay/webhook, events subscription.*.
# Set a long random secret in the dashboard and put the identical value here.
# Checkout stays disabled until webhooks are configured so payment updates are verified.
RAZORPAY_WEBHOOK_SECRET=
# Feedback form table: node scripts/setup-feedback.mjs --apply creates it.
APPWRITE_FEEDBACK_COLLECTION_ID=feedback

#SITE (public; shown on the Contact, Terms, Privacy and Refunds pages)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_CONTACT_PHONE=
# Promo and referral codes table: node scripts/setup-codes.mjs --apply creates it.
APPWRITE_CODES_COLLECTION_ID=codes

# SEARCH ENGINES (optional). Only for the "HTML tag" way of proving you own the
# site; the DNS-record way needs nothing here. Paste just the code, not the tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

#ADMIN PORTAL (github.com/hell-walk/Admin-Portal). Its "npm run setup -- --apply" makes these
# tables in the same database. Leave empty and Horizon behaves as before.
# webhook_log: one row per Razorpay webhook delivery, for the portal's Payments page.
APPWRITE_WEBHOOK_LOG_COLLECTION_ID=
# terms: lender and subscription names the team adds; matched on top of the built-in lists.
APPWRITE_TERMS_COLLECTION_ID=
# settings: the prices and Razorpay plan ids set from the portal (else plans.ts and the ids above).
APPWRITE_SETTINGS_COLLECTION_ID=

# --- Reminders (web push + email) -------------------------------------------
# Web push keys: generate once with `npx web-push generate-vapid-keys`.
# The public key goes to browsers; the private key never leaves the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# Email through Brevo (transactional API). The sender address must be a
# verified sender or on a domain authenticated in Brevo (SPF + DKIM in DNS).
BREVO_API_KEY=
REMINDER_FROM_EMAIL=
REMINDER_FROM_NAME=Horizon
# Where replies to a reminder go (optional), e.g. a mailbox someone reads.
REMINDER_REPLY_TO=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/reminders
# and /api/cron/backup (schedules in vercel.json). Any long random string.
CRON_SECRET=

#BACKUPS (nightly copy of every Appwrite table and every login to Cloudflare R2,
# encrypted; docs/deploy-vercel.md section 9). An R2 bucket and an API token
# with object read and write on that bucket. BACKUP_KEY encrypts the files and
# lives only here: keep a copy somewhere safe, or the backups cannot be opened.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=horizon-backups
BACKUP_KEY=
